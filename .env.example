# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/mallocmentor"

# NextAuth (运行 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成)
AUTH_SECRET="your_auth_secret_here"
AUTH_URL="http://localhost:3000"

# Coze AI 配置（每个 Bot 独立配置 TOKEN / URL / PROJECT_ID）

# AI 面试官
COZE_INTERVIEW_TOKEN=""
COZE_INTERVIEW_URL=""
COZE_INTERVIEW_PROJECT_ID=""

# 代码审查
COZE_CODE_REVIEW_TOKEN=""
COZE_CODE_REVIEW_URL=""
COZE_CODE_REVIEW_PROJECT_ID=""

# 知识助手
COZE_KNOWLEDGE_TOKEN=""
COZE_KNOWLEDGE_URL=""
COZE_KNOWLEDGE_PROJECT_ID=""

# 学习路径推荐
COZE_LEARNING_PATH_TOKEN=""
COZE_LEARNING_PATH_URL=""
COZE_LEARNING_PATH_PROJECT_ID=""

# 代码执行沙盒
# 方案一（推荐）：Wandbox（免费，无需注册，支持 C/C++）
SANDBOX_PROVIDER="wandbox"
SANDBOX_API_URL="https://wandbox.org"

# 方案二：Piston（需自建实例，公共实例已于 2026/2 关闭）
# SANDBOX_PROVIDER="piston"
# SANDBOX_API_URL="http://your-piston-instance:2000/api/v2"

# 方案三：Judge0 via RapidAPI（按量付费 $0.0017/次，需绑卡）
# 注册地址：https://rapidapi.com/judge0-official/api/judge0-ce
# SANDBOX_PROVIDER="judge0"
# SANDBOX_API_URL="https://judge0-ce.p.rapidapi.com"
# SANDBOX_API_KEY="your_rapidapi_key_here"
# SANDBOX_API_HOST="judge0-ce.p.rapidapi.com"
